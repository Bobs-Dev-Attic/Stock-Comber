# Slim the Vercel deployment to what the edge needs.
#
# We set `framework: null` in vercel.json so `api/*.py` are served as regular
# serverless functions. Vercel installs their Python deps from the root
# requirements.txt (kept), so DO NOT ignore it. We still hide pyproject.toml so
# Vercel never re-classifies the repo as a single-entrypoint Python "backend
# framework" (CLI 59 behaviour), which is what broke earlier builds.
pyproject.toml

# Nothing below is needed at the edge.
tests/
docs/
config/
stock_comber.egg-info/
reports/screen-*
.github/
