{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/screen.py": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "stock_comber/**"
    },
    "api/latest.py": {
      "memory": 256,
      "maxDuration": 10,
      "includeFiles": "public/data/latest.json"
    }
  }
}
