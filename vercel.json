{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/latest", "destination": "/data/latest.json" }
  ],
  "functions": {
    "api/screen.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "stock_comber/**"
    },
    "api/export.py": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{stock_comber/**,public/data/latest.json}"
    },
    "api/settings.py": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/runs.py": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/tickers.py": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/queue.py": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/analytics.py": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/analyze.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "stock_comber/**"
    },
    "api/signals.py": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/backtest.py": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "stock_comber/**"
    },
    "api/universe.py": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "stock_comber/**"
    },
    "api/thesis.py": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "stock_comber/**"
    }
  }
}
