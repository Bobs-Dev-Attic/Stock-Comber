{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    {
      "src": "api/latest.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["public/data/latest.json"] }
    },
    {
      "src": "api/screen.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["stock_comber/**"] }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
