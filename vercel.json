{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/screen.py": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "stock_comber/**"
    },
    "api/latest.py": {
      "memory": 256,
      "maxDuration": 10,
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ]
}
